{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    // moduleResolution "node" (node10) y baseUrl están deprecados desde TS 5.9 y se
    // eliminan en TS 7.0 (https://aka.ms/ts6). No migramos a node16/nodenext todavía
    // porque cambiaría el comportamiento real de resolución (exigiría extensiones en los
    // imports relativos); silenciamos el aviso sin tocar el comportamiento del proyecto.
    "ignoreDeprecations": "5.0",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
